{
  "id": "./",
  "name": "Lottie Editor",
  "short_name": "Lottie Editor",
  "description": "Edit, customize and optimize Lottie and dotLottie animations in the browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#16171a",
  "theme_color": "#16171a",
  "categories": ["design", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/json": [".json"],
        "application/zip": [".lottie"],
        "application/x-tgsticker": [".tgs"]
      },
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "shortcuts": [
    { "name": "Editor", "url": "./#/edit" },
    { "name": "Customize", "url": "./#/customize" },
    { "name": "Optimizer", "url": "./#/optimize" }
  ]
}
